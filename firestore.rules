rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules
     *
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model centered around Firebase Authentication UIDs.
     * Access is primarily governed by the document path and denormalized ownership fields to ensure
     * high performance and authorization independence.
     *
     * Data Structure:
     * - /mythicCodes/{mythicCodeId}: Global collection for club access codes.
     * - /users/{userId}: Root profiles where {userId} matches the Firebase Auth UID.
     * - /users/{userId}/pets/{petId}: User-specific subcollections for pet data.
     *
     * Key Security Decisions:
     * - Path-Based Ownership: User data and their subcollections are secured by matching the path 
     *   segment directly to the request.auth.uid.
     * - Denormalization: Critical fields like 'userId' are required on child documents (Pets) to 
     *   allow for standalone authorization checks without parent document lookups.
     * - Prototyping Flexibility: Rules enforce WHO can access data and relational integrity, 
     *   but do not restrict the specific fields or data types (schema) of the content itself.
     * - Listing: Permitida para usuários logados na coleção /users para suportar contagem de membros e ranking.
     */

    // --- Helper Functions ---

    /** Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** 
     * Checks if the authenticated user's UID matches the provided userId 
     * AND ensures the document currently exists for updates or deletes. 
     */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for unique access codes.
     * @path /mythicCodes/{mythicCodeId}
     */
    match /mythicCodes/{mythicCodeId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false; // Managed by backend/serverless
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if false;
    }

    /**
     * @description Rules for User Profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Permitido para contagem de membros e ranking
      
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for Pets.
       * @path /users/{userId}/pets/{petId}
       */
      match /pets/{petId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

  }
}