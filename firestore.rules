
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules - v2026
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    match /users/{userId} {
      allow list: if true; 
      allow get: if isSignedIn() || (resource != null && resource.data.isPublicProfile == true);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      match /pets/{petId} {
        allow get: if true;
        allow list: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    match /transferRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow list: if true; // Necessário para validar a transferência antes do login
      allow get: if true;
      allow update: if isSignedIn(); // Necessário para marcar como processado no final
      allow delete: if false;
    }
  }
}
