
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HALL BLACK CLUB - PROTOCOLO DE ELITE v2026.12
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read, list: if true;
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow update: if isOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED') || isAdmin();

      match /pets/{petId} {
        allow read: if true; 
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /vault/{articleId} {
      allow read, list, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow update: if true;
      allow list, create, delete: if isAdmin();
    }

    match /councilMessages/{messageId} {
      // Membro cria sua própria mensagem
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Membro lê suas mensagens ou Admin lê todas
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Apenas Admin responde
      allow update: if isAdmin();
    }
  }
}
