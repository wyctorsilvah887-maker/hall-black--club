
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HALL BLACK CLUB - PROTOCOLO DE SEGURANÇA v2026.8
     * Sistema de regras auditado para ecossistema de elite.
     * 
     * NOTA: A listagem de usuários (/users) é pública para permitir o 
     * funcionamento do contador de slots e a transparência da rede.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Regras de Chaves de Acesso ---
    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // --- Regras de Membros (Dossiês) ---
    // Match na coleção e documentos de usuários
    match /users/{userId} {
      // Listagem pública para contador de slots e High Council
      allow list: if true;
      
      // Get permitido se for o dono ou se o perfil for público
      allow get: if isSignedIn() || (resource != null && resource.data.isPublicProfile == true);
      
      allow create: if isOwner(userId);
      
      // Permite update se for o dono OU se for uma revogação via transferência
      allow update: if isOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED');
      
      allow delete: if isOwner(userId);

      // Subcoleção de Pets (Acesso total para o dono, leitura para rede)
      match /pets/{petId} {
        allow read: if true; 
        allow write: if isOwner(userId);
      }
    }

    // --- Regras de Protocolos de Transferência ---
    match /transferRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow list, get: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    // --- Regras do Cofre de Elite (The Vault) ---
    match /vault/{articleId} {
      // Acesso ao conhecimento exclusivo para membros autenticados
      allow list, get: if isSignedIn();
    }
  }
}
