rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Regras para a coleção de usuários e seus documentos
    match /users/{userId} {
      // Permite listar a coleção para a funcionalidade de contagem de membros (#099)
      // No Firestore, 'allow list' em match /users/{userId} autoriza consultas na coleção 'users'
      allow list: if isSignedIn();
      
      // Permite leitura de perfis individuais (necessário para ranking e visualização pública)
      allow get: if isSignedIn();
      
      // Regras de propriedade para gerenciamento de perfil
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;

      // Regras para a subcoleção de pets
      match /pets/{petId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Regras para os códigos míticos de ativação
    match /mythicCodes/{mythicCodeId} {
      allow get: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list, create, delete: if false;
    }
  }
}