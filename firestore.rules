
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SOVEREIGN FOUNDERS CLUB - PROTOCOLO DE ELITE v2026.12
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read, list: if true;
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow update: if isOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED') || isAdmin();
    }

    match /notifications/{notifId} {
      // Use 'in' operator to better match client queries using 'where ... in'
      allow read, list: if isSignedIn() && (resource.data.userId in [request.auth.uid, 'global']);
      allow create, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, list, delete, update: if isAdmin();
    }

    match /globalConfigs/{configId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /vault/{articleId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow update: if true;
      allow list, create, delete: if isAdmin();
    }

    match /councilMessages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }
  }
}
