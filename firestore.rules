
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules - v2026.5
     * Protocolos de segurança auditados para o ecossistema de elite.
     * 
     * NOTA: A listagem de usuários deve ser pública para permitir o funcionamento 
     * do contador de exclusividade (60 slots) e a transparência da rede.
     * Os detalhes sensíveis de cada membro permanecem protegidos.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Regras de Chaves de Acesso ---

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // --- Regras de Dossiês de Usuários ---

    match /users/{userId} {
      // Listagem pública obrigatória para visualização da rede e contador de slots
      allow list: if true;
      
      // Get permitido se for o próprio dono ou se o perfil for explicitamente público
      allow get: if isSignedIn() || (resource != null && resource.data.isPublicProfile == true);
      
      allow create: if isOwner(userId);
      
      // Permite update se for o dono OU se for uma revogação autorizada durante transferência
      allow update: if isExistingOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED');
      
      allow delete: if isExistingOwner(userId);

      // Subcoleção de Pets
      match /pets/{petId} {
        allow get: if true; 
        allow list: if true; 
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }
    }

    // --- Regras de Protocolos de Transferência ---

    match /transferRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow list, get: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    // --- Regras do Cofre de Elite (The Vault) ---

    match /vault/{articleId} {
      // Acesso restrito ao conhecimento apenas para membros autenticados
      allow list, get: if isSignedIn();
    }
  }
}
