
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SOVEREIGN FOUNDERS CLUB - PROTOCOLO DE ELITE v2026.12
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'admin';
    }

    match /users/{userId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      // Regra simplificada para permitir listagem com filtros complexos (in, orderBy)
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, list, delete, update: if isAdmin();
    }

    match /globalConfigs/{configId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /vault/{articleId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow update: if true;
      allow list, create, delete: if isAdmin();
    }

    match /councilMessages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }
  }
}
