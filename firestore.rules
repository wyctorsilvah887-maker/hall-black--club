rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /mythicCodes/{mythicCodeId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Explicitly allow listing the users collection for registration count (#099)
    match /users {
      // Allow listing the collection to count members
      allow list: if isSignedIn();
      
      match /{userId} {
        // Allow reading individual profiles for the ranking and public views
        allow get: if isSignedIn();
        
        // Ownership rules for profile management
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        match /pets/{petId} {
          allow get, list: if isOwner(userId);
          allow create, update, delete: if isOwner(userId);
        }
      }
    }
  }
}