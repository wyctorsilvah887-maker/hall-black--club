
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for unique access codes.
     * Permite leitura individual para validação antes do login.
     * Impede a listagem de todos os códigos para segurança.
     */
    match /mythicCodes/{mythicCodeId} {
      allow get: if true; // Permite get para validação de chave no Gate
      allow list: if false; // Ninguém lista todas as chaves
      allow create: if false; // Apenas via console ou admin
      allow update: if isSignedIn(); // Permite atualizar para 'activated' durante o registro
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      match /pets/{petId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}
