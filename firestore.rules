
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules - v2026.4
     * Protocolos de segurança otimizados para o Elite Hub.
     * Permitimos visibilidade da rede (listagem) para manter o desejo e prestígio,
     * enquanto protege a integridade dos dossiês individuais.
     * NOTA: A listagem pública é necessária para o contador de slots e a galeria do conselho.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Regras de Chaves de Acesso ---

    match /mythicCodes/{mythicCodeId} {
      // Chaves individuais podem ser consultadas publicamente para validação inicial
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // --- Regras de Dossiês de Usuários ---

    match /users/{userId} {
      // Permitimos listagem pública para o contador de slots e galeria do conselho (Desejabilidade)
      // Essencial para o funcionamento do EliteHub e AccessGate.
      allow list: if true;
      
      // Permitimos get se for o próprio dono ou se o perfil for explicitamente público
      allow get: if isSignedIn() || (resource != null && resource.data.isPublicProfile == true);
      
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      
      // Permite update se for o dono OU se for uma revogação autorizada durante transferência
      allow update: if isExistingOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED');
      
      allow delete: if isExistingOwner(userId);

      // Subcoleção de Pets
      match /pets/{petId} {
        allow get: if true; // Identidade do pet é consultável via QR Code
        allow list: if true; // Listagem permitida para verificação de linhagem
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    // --- Regras de Protocolos de Transferência ---

    match /transferRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow list: if isSignedIn(); 
      allow get: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    // --- Regras do Cofre de Elite (The Vault) ---

    match /vault/{articleId} {
      // Acesso restrito ao conhecimento técnico apenas para membros da rede
      allow list, get: if isSignedIn();
    }
  }
}
