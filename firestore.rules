
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Hall Black Club Security Rules - v2026
     * Protocolos de segurança atualizados para suporte ao Elite Vault e Advisor.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Regras de Chaves de Acesso ---

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // --- Regras de Dossiês de Usuários ---

    match /users/{userId} {
      allow list: if true; 
      allow get: if isSignedIn() || (resource != null && resource.data.isPublicProfile == true);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Permite update se for o dono OU se for uma revogação autorizada durante transferência
      allow update: if isExistingOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED');
      allow delete: if isExistingOwner(userId);

      match /pets/{petId} {
        allow get: if true;
        allow list: if isSignedIn();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    // --- Regras de Protocolos de Transferência ---

    match /transferRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow list: if true; 
      allow get: if true;
      allow update: if isSignedIn(); 
      allow delete: if false;
    }

    // --- Regras do Cofre de Elite (The Vault) ---

    match /vault/{articleId} {
      // Membros autenticados possuem autorização para consultar o conhecimento técnico
      allow list, get: if isSignedIn();
    }
  }
}
