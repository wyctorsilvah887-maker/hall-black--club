
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HALL BLACK CLUB - PROTOCOLO DE ELITE v2026.10
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, list: if true;
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow update: if isOwner(userId) || (isSignedIn() && request.resource.data.status == 'REVOKED');

      match /pets/{petId} {
        allow read: if true; 
        allow write: if isOwner(userId);
      }
    }

    match /vault/{articleId} {
      allow read, list, create: if isSignedIn();
    }

    match /mythicCodes/{mythicCodeId} {
      allow get: if true;
      allow update: if true;
      allow list, create, delete: if false;
    }

    match /transferRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if true;
      allow delete: if false;
    }

    match /councilMessages/{messageId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (request.query.limit <= 100);
    }
  }
}
