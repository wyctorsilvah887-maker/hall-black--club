
{
  "entities": {
    "MythicCode": {
      "title": "MythicCode",
      "type": "object",
      "description": "Chaves de acesso originais da rede.",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "activated"] },
        "status_rank": { "type": "string" },
        "theme": { "type": "string" }
      },
      "required": ["id", "code", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Dossiê do membro elite.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "theme": { "type": "string" },
        "memberNumber": { "type": "number" },
        "registrationDateTime": { "type": "string", "format": "date-time" },
        "pedigreeScore": { "type": "number", "description": "Pontuação de prestígio baseada em linhagem e tempo." },
        "isPublicProfile": { "type": "boolean" }
      },
      "required": ["id", "name", "email"]
    },
    "VaultArticle": {
      "title": "VaultArticle",
      "type": "object",
      "description": "Conhecimento técnico e masterclasses exclusivas.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["GENETICS", "HEALTH", "LIFESTYLE"] },
        "content": { "type": "string" },
        "restrictedTo": { "type": "string", "enum": ["MYTHIC", "AMBER", "LEGENDARY"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "category"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/mythicCodes/{mythicCodeId}": {
      "schema": "MythicCode",
      "description": "Controle de chaves HB."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dossiês de membros."
    },
    "/vault/{articleId}": {
      "schema": "VaultArticle",
      "description": "Cofre de conhecimento restrito."
    }
  }
}
