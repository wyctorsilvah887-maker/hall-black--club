
{
  "entities": {
    "MythicCode": {
      "title": "MythicCode",
      "type": "object",
      "description": "Chaves de acesso originais da rede.",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "activated"] },
        "status_rank": { "type": "string" },
        "theme": { "type": "string" }
      },
      "required": ["id", "code", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Dossiê do membro elite.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "admin"], "description": "Define o nível de acesso: 'member' para uso comum ou 'admin' para acesso ao Painel Staff." },
        "theme": { "type": "string" },
        "memberNumber": { "type": "number" },
        "registrationDateTime": { "type": "string", "format": "date-time" },
        "eliteScore": { "type": "number", "description": "Pontuação de prestígio baseada em linhagem e tempo." },
        "isPublicProfile": { "type": "boolean" },
        "aiMessageCount": { "type": "integer", "description": "Contagem de mensagens enviadas à IA no ciclo atual." },
        "lastAiMessageReset": { "type": "string", "format": "date-time", "description": "Timestamp do último reset de créditos da IA." },
        "photo": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Lead": {
      "title": "Lead",
      "type": "object",
      "description": "Dados capturados de interessados na rede.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "whatsapp"]
    },
    "VaultArticle": {
      "title": "VaultArticle",
      "type": "object",
      "description": "Conhecimento estratégico, modelos de SaaS e masterclasses empresariais de elite.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "restrictedTo": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "category"]
    },
    "CouncilMessage": {
      "title": "CouncilMessage",
      "type": "object",
      "description": "Comunicações oficiais entre membros e o Alto Conselho.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "replied"] },
        "reply": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "timestamp"]
    },
    "LoungeMessage": {
      "title": "LoungeMessage",
      "type": "object",
      "description": "Mensagens de chat em tempo real no Black Room.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "userRank": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "content", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/mythicCodes/{mythicCodeId}": {
      "schema": "MythicCode",
      "description": "Controle de chaves Sovereign."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Dossiês de membros Founders."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Captura de leads interessados."
    },
    "/vault/{articleId}": {
      "schema": "VaultArticle",
      "description": "Cofre de inteligência estratégica restrita."
    },
    "/councilMessages/{messageId}": {
      "schema": "CouncilMessage",
      "description": "Canal de audiência do Alto Conselho."
    },
    "/loungeMessages/{messageId}": {
      "schema": "LoungeMessage",
      "description": "Mensagens do Black Room."
    }
  }
}
